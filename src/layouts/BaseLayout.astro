---
import { content, languages } from '../content';
import type { Lang } from '../content/types';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE, pathFor, type PageKey } from '../lib/paths';
import '../styles/global.css';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const c = content[lang];
const origin = Astro.site ?? new URL('https://exemple.github.io');
const canonical = new URL(pathFor(lang, page), origin).href;

const ogLocale: Record<Lang, string> = {
  ca: 'ca_ES',
  es: 'es_ES',
  en: 'en_GB',
};

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: c.site.name,
  jobTitle: c.site.role,
  email: `mailto:${c.site.email}`,
  url: canonical,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tordera',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  sameAs: [c.site.github],
  knowsLanguage: ['ca', 'es', 'en', 'pt'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={c.site.name} />
    <link rel="canonical" href={canonical} />
    {
      languages.map((l) => (
        <link
          rel="alternate"
          hreflang={l.code}
          href={new URL(pathFor(l.code, page), origin).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('ca', page), origin).href} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <meta name="theme-color" content="#f4f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070b15" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        document.documentElement.classList.add('has-js');
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body id="top">
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
    <a class="skip" href="#main">{c.ui.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      (function () {
        var root = document.documentElement;

        var toggle = document.querySelector('[data-theme-toggle]');
        function syncTheme() {
          if (!toggle) return;
          var dark = root.dataset.theme === 'dark';
          toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
          var label = dark ? toggle.dataset.labelLight : toggle.dataset.labelDark;
          if (label) {
            toggle.setAttribute('aria-label', label);
            toggle.setAttribute('title', label);
          }
        }
        if (toggle) {
          toggle.addEventListener('click', function () {
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch (e) {}
            syncTheme();
          });
          syncTheme();
        }

        document.querySelectorAll('[data-print]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            window.print();
          });
        });

        document.querySelectorAll('[data-phone]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var link = document.createElement('a');
            link.href = 'tel:' + btn.dataset.phoneHref;
            link.textContent = btn.dataset.phone;
            btn.replaceWith(link);
          });
        });

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach(function (el) {
            el.classList.add('is-visible');
          });
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
          );
          items.forEach(function (el) {
            io.observe(el);
          });
        }

        var bar = document.querySelector('[data-progress]');
        var header = document.querySelector('.site-header');
        function onScroll() {
          var doc = document.documentElement;
          var max = doc.scrollHeight - doc.clientHeight;
          var ratio = max > 0 ? doc.scrollTop / max : 0;
          if (bar) bar.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
          if (header) header.classList.toggle('is-scrolled', doc.scrollTop > 6);
        }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
      })();
    </script>
  </body>
</html>
