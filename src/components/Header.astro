---
import { content, languages } from '../content';
import type { Lang } from '../content/types';
import { pathFor, type PageKey } from '../lib/paths';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const c = content[lang];

const navItems: { key: PageKey; label: string }[] = [
  { key: 'home', label: c.nav.home },
  { key: 'cv', label: c.nav.cv },
  { key: 'letter', label: c.nav.letter },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={pathFor(lang)}>
      <span class="brand__mark" aria-hidden="true">{c.site.initials}</span>
      <span>
        <span class="brand__name">{c.site.name}</span>
        <span class="brand__role">{c.site.role}</span>
      </span>
    </a>

    <nav class="nav" aria-label={c.ui.mainNav}>
      {
        navItems.map((item) => (
          <a
            href={pathFor(lang, item.key)}
            aria-current={item.key === page ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="nav__cta" href={`${pathFor(lang, 'cv')}#contacte`}>{c.nav.contact}</a>
    </nav>

    <div class="tools">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        data-label-dark={c.ui.themeToDark}
        data-label-light={c.ui.themeToLight}
        aria-pressed="false"
        aria-label={c.ui.themeToDark}
        title={c.ui.themeToDark}
      >
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
        <span class="sr-only">{c.ui.themeToggle}</span>
      </button>

      <div class="lang" aria-label={c.ui.langLabel}>
        {
          languages.map((l, index) => (
            <>
              {index > 0 && <span class="lang__sep" aria-hidden="true">/</span>}
              <a
                href={pathFor(l.code, page)}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.code === lang ? 'page' : undefined}
                title={l.label}
              >
                {l.short}
              </a>
            </>
          ))
        }
      </div>
    </div>
  </div>
</header>
